{
	"name": "code-bin",
	"version": "1.3.0",
	"description": "Write HTML, CSS and JavaScript in WordPress and show it with a live preview your visitors can edit.",
	"author": "Peter Wilson",
	"license": "MIT",
	"homepage": "https://github.com/peterwilsoncc/code-bin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/peterwilsoncc/code-bin.git"
	},
	"bugs": {
		"url": "https://github.com/peterwilsoncc/code-bin/issues"
	},
	"main": "build/index.js",
	"files": [
		"build",
		"inc",
		"templates",
		"code-bin.php",
		"readme.txt",
		"LICENSE"
	],
	"scripts": {
		"build": "npm run build:readme && wp-scripts build --webpack-copy-php --blocks-manifest",
		"build:readme": "node bin/build-readme.mjs",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php --blocks-manifest"
	},
	"devDependencies": {
		"@wordpress/icons": "^20.0.0",
		"@wordpress/scripts": "^37.1.0"
	},
	"dependencies": {
		"acorn": "^8.19.0",
		"acorn-walk": "^8.3.5",
		"microlighter": "^2.2.0"
	}
}
