{
    "name": "peterwilsoncc/code-bin",
    "description": "Write HTML, CSS and JavaScript in WordPress and show it with a live preview your visitors can edit.",
    "homepage": "https://github.com/peterwilsoncc/code-bin",
    "type": "wordpress-plugin",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "license": "MIT",
    "support": {
        "issues": "https://github.com/peterwilsoncc/code-bin/issues",
        "source": "https://github.com/peterwilsoncc/code-bin"
    },
    "authors": [
        {
            "name": "Peter Wilson",
            "email": "peter@peterwilson.cc"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
