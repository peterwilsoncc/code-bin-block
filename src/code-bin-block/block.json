{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "code-bin-block/code-bin-block",
	"version": "1.3.0",
	"title": "Code Bin",
	"category": "embed",
	"icon": "code",
	"description": "Write HTML, CSS and JavaScript and show it with a live preview, like CodePen or JS Bin.",
	"example": {
		"attributes": {
			"html": "<button>Click me</button>",
			"css": "button { font-size: 1.25rem; }",
			"javascript": "const button = document.querySelector( 'button' );\nbutton.addEventListener( 'click', () => {\n\tbutton.textContent = 'Clicked!';\n} );"
		}
	},
	"attributes": {
		"html": {
			"type": "string",
			"default": ""
		},
		"css": {
			"type": "string",
			"default": ""
		},
		"javascript": {
			"type": "string",
			"default": ""
		},
		"editable": {
			"type": "boolean",
			"default": true
		},
		"previewHeight": {
			"type": "number",
			"default": 300
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true
	},
	"textdomain": "code-bin",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
